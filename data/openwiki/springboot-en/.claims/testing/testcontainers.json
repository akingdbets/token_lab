    {
      "id": "claim_51ebd38604b04d9398bfabc67ff25551",
      "statement": "In following sections we will describe some of the methods you can use to integrate Testcontainers with your tests.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/testing/testcontainers.adoc#L1-L268",
          "version": "repo-lines-v1:sha256:e63f7ab9067c6f862e08494dc4da4e97ce1d353a08a66a43507bbf6bc658e216:"
