    {
      "id": "claim_5487d70332d742b6930354e2e5d63d59",
      "statement": "This is a multi-stage Dockerfile. The builder stage extracts the directories that are needed later. Each of the COPY commands relates to the layers extracted by the jarmode.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/packaging/container-images/dockerfiles.adoc#L1-L101",
