    {
      "id": "claim_75511f66958b49558ec4cd7ba3e3d28e",
      "statement": "To opt-out of constructor binding for a class, the parameterized constructor must be annotated with @Autowired or made private. Kotlin developers can use an empty primary constructor to opt-out of constructor binding.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/features/external-config.adoc#L850-L951",
          "version": "repo-lines-v1:sha256:4aa5a82c6e9a60c26b06de4001cb78d601425906f6b6d109d9dc2f333d5916d4:"
        }
      ]
    },
    {
      "id": "claim_9d5c3356d8cc42aba527678500c8fd1f",
      "statement": "Constructor binding can be used with records. Unless your record has multiple constructors, there is no need to use @ConstructorBinding.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/features/external-config.adoc#L850-L951",
          "version": "repo-lines-v1:sha256:4aa5a82c6e9a60c26b06de4001cb78d601425906f6b6d109d9dc2f333d5916d4:"
        }
      ]
    },
    {
      "id": "claim_e7c71c25e9d14cceb20445be03798ae8",
      "statement": "Nested members of a constructor bound class (such as Security in the example above) will also be bound through their constructor.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/features/external-config.adoc#L850-L951",
          "version": "repo-lines-v1:sha256:4aa5a82c6e9a60c26b06de4001cb78d601425906f6b6d109d9dc2f333d5916d4:"
