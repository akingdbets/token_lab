    {
      "id": "claim_c0daf674fd1b4be98d27d9516c77f72c",
      "statement": "You should always refer to property names in the placeholder using their canonical form (kebab-case using only lowercase letters). This will allow Spring Boot to use the same logic as it does when relaxed binding @ConfigurationProperties.",
