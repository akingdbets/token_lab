    {
      "id": "claim_b3dc2e28456644628b2c0ac6de2ee7ac",
      "statement": "Spring Boot provides infrastructure to bind @ConfigurationProperties types and register them as beans. You can either enable configuration properties on a class-by-class basis or enable configuration property scanning that works in a similar manner to component scanning.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/features/external-config.adoc#L967-L997",
          "version": "repo-lines-v1:sha256:4293de73b67ea7d07d3b6c5cdaba1a5080fc645c73368d70ead4c5e8c3228afe:"
        },
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/main/java/org/springframework/boot/docs/features/externalconfig/typesafeconfigurationproperties/enablingannotatedtypes/MyApplication.java",
          "version": "repo-file-v1:sha256:b82684c19f1acf5ff08b347de5c05054190911504bd25d972025d6f271886a12"
        },
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/main/java/org/springframework/boot/docs/features/externalconfig/typesafeconfigurationproperties/enablingannotatedtypes/MyConfiguration.java",
          "version": "repo-file-v1:sha256:ae0e92da3ad52e8be3d17634ff83770f35073530348fd91153b99996209fe411"
        },
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/main/java/org/springframework/boot/docs/features/externalconfig/typesafeconfigurationproperties/enablingannotatedtypes/SomeProperties.java",
          "version": "repo-file-v1:sha256:129d909a7a000706b586a26b4ee0adcb3bfcfbbe6f9328e3f474e8688c9dad8d"
        }
