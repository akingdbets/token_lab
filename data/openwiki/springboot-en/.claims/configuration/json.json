    {
      "id": "claim_1317eebc7b4348cb8de137e62efce766",
      "statement": "Support for Jackson 2 is deprecated and will be removed in a future Spring Boot 4.x release. It is provided purely to ease the migration from Jackson 2 to Jackson 3 and should not be relied up in the longer term.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/features/json.adoc#L1-L104",
          "version": "repo-lines-v1:sha256:689790eeea2ffb6e5491938b0a25504578135189d3b4b1d05e9fd97e1588c218:"
        },
        {
