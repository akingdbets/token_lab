    {
      "id": "claim_cb7c7ec1bb66434bbd88ab136ba0b608",
      "statement": "One of the biggest advantages of packaging your application as a jar and using an embedded HTTP server is that you can run your application as you would any other. The same applies to debugging Spring Boot applications. You do not need any special IDE plugins or extensions.",
      "evidence": [
        {
          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/using/running-your-application.adoc#L1-L104",
