    {
      "id": "claim_046298e7b664449eb51a9b1243ec609a",
      "statement": "If you are using this feature in your tests, you may notice that the same database is reused by your whole test suite regardless of the number of application contexts that you use. If you want to make sure that each context has a separate embedded database, you should set spring.r2dbc.generate-unique-name to true.",
      "evidence": [
