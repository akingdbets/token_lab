          "resource": "repo://upstream/documentation/spring-boot-docs/src/docs/antora/modules/reference/pages/data/sql.adoc#L494-L583",
          "version": "repo-lines-v1:sha256:2681f79f2146762b7fb751f3b15fe0683412543fcd1c8322680a97485ad948dd:"
