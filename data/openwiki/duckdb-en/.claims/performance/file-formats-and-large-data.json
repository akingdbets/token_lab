  "claims": [
    {
      "id": "claim_d84993b86a7248068c4c274a2ac3a65e",
      "statement": "DuckDB's native format has HyperLogLog statistics that Parquet lacks, so join-heavy or repeated workloads benefit from loading Parquet into DuckDB; TPC-H SF30 ran 1.1-4.1x slower on Parquet.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/file_formats.md#L19-L39",
          "version": "repo-lines-v1:sha256:7fc7103bdc7d57381c00ef9e851beee54f1ae1edf533e7bbffcf992b0bdbf410:"
        }
      ]
    },
    {
      "id": "claim_0bde2b16fa89435bbe9759df1628d5cc",
      "statement": "DuckDB parallelizes over Parquet row groups and works best with 100K-1M rows per row group; 2,048-row groups were about 3.7x slower.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/file_formats.md#L41-L65",
          "version": "repo-lines-v1:sha256:2d9f0e74146147bf9762cb7fae4ba946bd9df9acd4b3fc8d14082492447ef6a9:"
        }
      ]
    },
    {
      "id": "claim_ed1ae7f3cf574f0cbea5349997106ba7",
      "statement": "The docs recommend at least as many total row groups as CPU threads and individual Parquet files between 100 MB and 10 GB.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/file_formats.md#L67-L71",
          "version": "repo-lines-v1:sha256:a20b706edef5a872421c0decc64f9dda9162f302f059de81089da335a5b0ec53:"
        }
      ]
    },
    {
      "id": "claim_b667bef4eeeb403983f6eccf8d3367e7",
      "statement": "Loading gzip-compressed CSV directly is typically faster than decompressing first, and disabling the sniffer speeds up loading many small CSV files.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/file_formats.md#L81-L109",
          "version": "repo-lines-v1:sha256:eea8031959b8f7788928b1186b6d378d433b509dfb0acf2f84b2bcc781e998be:"
        }
      ]
    },
    {
      "id": "claim_4243a1421a4245758f32f168df268705",
      "statement": "Recommended import order is scanner extensions, then bulk export to Parquet/CSV, then the Appender; row-by-row inserts should be avoided beyond about 100k rows.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/import.md#L14-L28",
          "version": "repo-lines-v1:sha256:f9f265c4209690f38763e56480ee4ca793e939bde4696f3997883459c6829d95:"
        }
      ]
    },
    {
      "id": "claim_0633f8ced72b4afab5080080a0f0e737",
      "statement": "To avoid out-of-memory errors, reduce threads, set memory_limit to 50-60% if the OS kills DuckDB, and set preserve_insertion_order = false; indexes are not buffer-managed.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/oom.md#L13-L33",
          "version": "repo-lines-v1:sha256:b1d6906e97d7b41286905fdb6179415e3efccdc8ad9ee2b4622005eefa24468c:"
        }
      ]
    },
    {
      "id": "claim_dea59320e10343b98361b322ecf62b06",
      "statement": "Huge databases are limited by object storage file sizes such as 5 TB on S3, checkpointing can be slow, and XFS performs best on Linux; DuckLake is suggested for large data.",
      "evidence": [
        {
          "resource": "repo://docs/2.0/guides/performance/working_with_huge_databases.md#L12-L24",
          "version": "repo-lines-v1:sha256:d1b663ee845bfd7d212107e4b0d037241bad049a2fec5eaff8208087078b5b18:"
