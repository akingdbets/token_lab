        {
          "resource": "repo://docs/2.0/sql/dialect/postgresql_compatibility.md#L16-L58",
          "version": "repo-lines-v1:sha256:1c632f39fad410b7a1734df5380a8075424da33e24cd539fa5a60e40f8ac1f1a:"
        }
      ]
    },
    {
      "id": "claim_6337abcc3f094e2f8c4f219651bc46fa",
      "statement": "DuckDB does not exploit functional dependencies in GROUP BY, does not support to_date, and its regexp_extract returns empty strings instead of NULL.",
