        }
      ]
    },
    {
      "id": "claim_f45a9d7cbb8d48f3a25bc790ca78a1ac",
      "statement": "KIP-890 transaction protocol is enabled server-side by default since 4.0 via the transaction.version feature flag, bumps the producer epoch on every transaction, and producers upgrade at the start of the next transaction without restart.",
      "evidence": [
