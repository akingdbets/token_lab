        }
      ]
    },
    {
      "id": "claim_eae03707baac4bdebcd8b3e490101f12",
      "statement": "Compacted messages keep their original offsets, and a record with a key and null payload is a tombstone that is itself removed after the delete retention point.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L403-L411",
          "version": "repo-lines-v1:sha256:c06aa46cb3d8934432377dfb49ac3c4d79df204efdefe24d4f559d9c10301b9d:"
        }
      ]
    },
    {
      "id": "claim_8902c26e9f0144a5af62e373ec185104",
      "statement": "Compaction never reorders messages or changes offsets, and consumers starting from the beginning see all tombstones only if they reach the head within delete.retention.ms (default 24 hours).",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L417-L424",
          "version": "repo-lines-v1:sha256:3458e63019d4f750dc51ad250d4b0e6e6d079b5572f83630832d7070d56a7e51:"
        }
      ]
    },
    {
      "id": "claim_187c774d562e48d3bc1c83f9feed87dc",
      "statement": "The log cleaner picks the log with the highest head-to-tail ratio, builds a 24-byte-per-entry key summary, and recopies the log swapping in clean segments so only one extra segment of disk is needed.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L427-L434",
          "version": "repo-lines-v1:sha256:e48e971b7dd8f4747b0bb7323642eed9f77886ce2884ed6774ae8e95944eb084:"
        }
      ]
    },
    {
      "id": "claim_038a43eb171d474496884a5a2b2a6cf2",
      "statement": "The active segment is never compacted; for compacted topics it rolls at segment.bytes or at the smaller of segment.ms and max.compaction.lag.ms, and max.compaction.lag.ms also makes rolled records eligible regardless of min.cleanable.dirty.ratio.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L451-L459",
          "version": "repo-lines-v1:sha256:5e7afd286a1be3dbd0fb2ce694c7a44a1b2709dcc61bb734cd3357bf2a39e6a2:"
        }
      ]
    },
