    {
      "id": "claim_3b50c124d49a4d1a89fc66917ff808dc",
      "statement": "Log compaction retains at least the last known value for each key within a topic partition and is configured per topic.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L368-L368",
          "version": "repo-lines-v1:sha256:bb10ce8833c7b8eccc051afcb79f2c91ab61b81f508bf49a8536640e2cd6de7b:"
