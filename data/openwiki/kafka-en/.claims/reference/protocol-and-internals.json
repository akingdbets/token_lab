  "claims": [
    {
      "id": "claim_7390c39bffdc44e59274136c10345f91",
      "statement": "Kafka uses a size-delimited binary request/response protocol over TCP, processes requests on a connection in order with a single in-flight request per connection, and disconnects sockets whose requests exceed the configured maximum size.",
      "evidence": [
        {
          "resource": "repo://docs/design/protocol.md#L37-L47",
          "version": "repo-lines-v1:sha256:062ef77f6ac4934983095ba140b4cd16a3bb87923272c6f06c28faa8ddbbe1a5:"
        }
      ]
    },
    {
      "id": "claim_c4951bc31591486b83a3b1331f9ba979",
      "statement": "Produce and fetch requests must go to the partition leader or receive NotLeaderForPartition, and clients bootstrap by fetching metadata from any broker and refresh it on errors.",
      "evidence": [
        {
          "resource": "repo://docs/design/protocol.md#L49-L67",
          "version": "repo-lines-v1:sha256:4f62587072a6324f24b7b80789488714c83892e56b53279a461f2072467b10a6:"
        }
      ]
    },
    {
      "id": "claim_9233c1d34f044419843ad268a26f8ccd",
      "statement": "Kafka has a bidirectional compatibility policy using API key and API version per request, with clients choosing the highest common version and tagged fields (KIP-482) allowing schema evolution without version bumps.",
      "evidence": [
        {
          "resource": "repo://docs/design/protocol.md#L92-L104",
          "version": "repo-lines-v1:sha256:632a034b95e5af7d513e45cb5d7d50422b397e677c4bc540cabb3ff987ad7581:"
        }
      ]
    },
    {
      "id": "claim_18b54164ac71484fbd9365a58405f5bc",
      "statement": "Brokers answer ApiVersionsRequest regardless of authentication state, respond with a v0 UNSUPPORTED_VERSION response when the client's ApiVersions version is too new (brokers 2.4.0+), and version information is only valid per connection.",
      "evidence": [
        {
          "resource": "repo://docs/design/protocol.md#L106-L118",
          "version": "repo-lines-v1:sha256:7d58e61439f0ec9a503cda35061eac573cdcb0fcd5a41d66f651f574d5b47ba7:"
        }
      ]
    },
    {
      "id": "claim_bcd585582ef9474480201353dc509433",
      "statement": "SASL authentication uses SaslHandshakeRequest followed by raw tokens (v0) or SaslAuthenticate-wrapped tokens (v1), and the connection is closed on unsupported mechanisms or failed authentication.",
      "evidence": [
        {
          "resource": "repo://docs/design/protocol.md#L120-L131",
          "version": "repo-lines-v1:sha256:8300b143f34b7c3b37ed07654574332d97e9b00d375c485c48d713ead4528f52:"
        }
      ]
    },
    {
      "id": "claim_e47a0fb184ab44e589e74ed8232f426e",
      "statement": "Flexible message versions use compact encodings with unsigned varint lengths and a trailing tagged-fields section.",
