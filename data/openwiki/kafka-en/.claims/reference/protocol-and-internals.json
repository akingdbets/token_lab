        {
          "resource": "repo://docs/design/protocol.md#L135-L141",
          "version": "repo-lines-v1:sha256:110b6d8e4e34dbe8493de718be9470605b435ce2f61e5b22e03688538d952de8:"
        }
      ]
    },
