    {
      "id": "claim_656fdf20e8a4460db94d31ea5ba92378",
      "statement": "The producer sends data directly to the partition leader using cluster metadata available from any broker, and the client chooses the partition, optionally by hashing a key.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L123-L127",
          "version": "repo-lines-v1:sha256:ab18cb467af02c6e1b3001eb34077f33dbc356d3f0056c762fffdc360aa11c99:"
        }
      ]
    },
    {
      "id": "claim_5a69ca9a9d654c1c82684b5b1ac9c63b",
      "statement": "The producer batches records in memory bounded by size and latency, trading a little latency for throughput, and linger.ms defaults to 5 ms after changing from 0 in Kafka 4.0.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L129-L131",
          "version": "repo-lines-v1:sha256:e58c5b6db325e8e555ce658acc6885b83b374fe4a066d9358320f6e34b733eaf:"
