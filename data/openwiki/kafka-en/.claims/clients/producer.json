        }
      ]
    },
    {
      "id": "claim_e2618134fdf24da49fcdb6e0722466b1",
      "statement": "Compressed batches are validated by the broker but stored and delivered to consumers in compressed form; GZIP, Snappy, LZ4 and ZStandard are supported, with compression.type defaulting to none.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L113-L119",
