        }
      ]
    },
    {
      "id": "claim_57031b80edf54d1185812c7becf61b0b",
      "statement": "Kerberos brokers use a KafkaServer Krb5LoginModule with a keytab, sasl.enabled.mechanisms=GSSAPI and sasl.kerberos.service.name matching the broker principal.",
