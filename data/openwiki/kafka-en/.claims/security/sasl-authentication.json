        }
      ]
    },
    {
      "id": "claim_d99c1ac13b1c48ee8b376e839de288ee",
      "statement": "SASL runs over SASL_PLAINTEXT or SASL_SSL, supports GSSAPI, PLAIN, SCRAM-SHA-256, SCRAM-SHA-512 and OAUTHBEARER, and clients may see slow handshakes without FQDNs due to reverse DNS lookups.",
      "evidence": [
        {
          "resource": "repo://docs/security/authentication-using-sasl.md#L90-L124",
