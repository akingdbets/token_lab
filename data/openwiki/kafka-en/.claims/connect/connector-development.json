  "claims": [
    {
      "id": "claim_7125d97370b54d26a36307f5cd4945dc",
      "statement": "Connectors do not copy data themselves; they split a job into SourceTask or SinkTask instances distributed to workers, and records carry source partitions and offsets that the framework commits periodically.",
      "evidence": [
        {
          "resource": "repo://docs/kafka-connect/connector-development-guide.md#L33-L45",
          "version": "repo-lines-v1:sha256:9c2f1457ba4f618b5f852e13e03ee256fe9fe5d87e54992629880850c6954997:"
        }
      ]
    },
    {
      "id": "claim_fa9556c26286450490af3de1f5b2e413",
      "statement": "SourceTasks run on a dedicated thread, so stop() must be synchronized, and poll() returns SourceRecords built from a source partition, source offset, topic and schema/value.",
      "evidence": [
        {
          "resource": "repo://docs/kafka-connect/connector-development-guide.md#L122-L183",
          "version": "repo-lines-v1:sha256:371a8f42289ab65db24df4f8dabe4cdcfe4b3ff6135e77f845a93f7df6a050fd:"
        }
      ]
    },
    {
      "id": "claim_2614ee23762d47a4a074caaa9d833c78",
      "statement": "SinkTask.put() may buffer records, while flush() is called during offset commit and must push outstanding data and block until acknowledged.",
