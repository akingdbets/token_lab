  "claims": [
    {
      "id": "claim_a89779bd68a04d5aa75d8778ccaf14a1",
      "statement": "Kafka enforces network bandwidth quotas (byte-rate, since 0.9) and request rate quotas (percentage of network and I/O thread time, since 0.11) per group of clients sharing a quota.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L465-L472",
          "version": "repo-lines-v1:sha256:14385f859d55f7283b97dd82da878ad94603661041eba69f009f8ff196d2e884:"
        }
      ]
    },
    {
      "id": "claim_115f48d166ad4eaebea708b964be7d4d",
      "statement": "Quotas apply to (user, client-id), user or client-id groups with the most specific match winning and shared by all connections in the group, following an eight-level precedence order, and overrides stored in the metadata log take effect immediately.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L478-L499",
          "version": "repo-lines-v1:sha256:98cc9644f3be969f8dbe2ced5c30f0d2b12822fa9a64de1a10cbf8b97d72f187:"
        }
      ]
    },
    {
      "id": "claim_1bcd76c6840d4c4d87e9f22c758929de",
      "statement": "Quotas are defined per broker; a request quota of n% is out of ((num.io.threads + num.network.threads) * 100)%.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L501-L507",
          "version": "repo-lines-v1:sha256:2d1a83fe5489766feee1e5697a45cf19fd3198d3d2dd6c9c6917432b5793816b:"
        }
      ]
    },
    {
      "id": "claim_9362604132124412acdb96e145a00b67",
      "statement": "On quota violation the broker returns a response with the computed delay and mutes the client channel until the delay expires, measuring usage over many small windows.",
      "evidence": [
        {
          "resource": "repo://docs/design/design.md#L509-L515",
          "version": "repo-lines-v1:sha256:dc6db52d336c20e8b8fa2c362fc81183eadd13117e9de4d8b40e0614e6c12c7e:"
        }
      ]
    },
    {
      "id": "claim_6e5e1ffaa6ea4d92bf18a740c75161da",
      "statement": "Clients have unlimited quota by default, and quotas such as producer_byte_rate, consumer_byte_rate and request_percentage are set and described with kafka-configs.sh using --entity-type users/clients and --entity-name or --entity-default.",
      "evidence": [
        {
          "resource": "repo://docs/operations/basic-kafka-operations.md#L759-L856",
          "version": "repo-lines-v1:sha256:56923fdf3a6a0d3e9d3973452346141a0c9f585b3d126266de2dacfa0669e763:"
        }
      ]
    },
    {
      "id": "claim_141603ccd39c4574a9f0c4874a444b0a",
      "statement": "For multi-tenancy Kafka recommends hierarchical topic naming combined with prefixed ACLs, CreateTopicPolicy, or disabling user topic creation, since topics cannot be renamed.",
      "evidence": [
        {
          "resource": "repo://docs/operations/multi-tenancy.md#L44-L79",
          "version": "repo-lines-v1:sha256:f4574ee8112daee478135c8704e2f9e0418f0c6c3f5bbd78531ab393b8871500:"
        }
      ]
    },
    {
      "id": "claim_d164158163b04de6a02bc99c376587b1",
      "statement": "Request rate quotas often isolate tenants better than bandwidth quotas, controller_mutation_rate quotas limit topic operations, and server quotas limit connection rates and counts.",
