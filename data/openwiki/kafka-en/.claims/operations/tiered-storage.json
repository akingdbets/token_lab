    {
      "id": "claim_3e93adc7f61041f590f8ec8100a6e5d3",
      "statement": "Tiered storage (KIP-405) adds a remote tier such as HDFS or S3 for completed log segments alongside the local disk tier.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L29-L33",
          "version": "repo-lines-v1:sha256:7ad5e8c5f4c04cffecdbee0b6c717e163de6571c4635f12a7295bc04a431134e:"
        }
      ]
    },
    {
      "id": "claim_7a64d95294064294815da27d57a1d207",
      "statement": "Tiered storage is disabled by default and enabled with remote.log.storage.system.enable; Kafka ships no RemoteStorageManager so remote.log.storage.manager.class.name must be configured, and the default topic-based RemoteLogMetadataManager requires remote.log.metadata.manager.listener.name.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L37-L43",
          "version": "repo-lines-v1:sha256:79dd71372a600b92485f3504f3560e63ad199ec137ce0d380f865b044a49bcad:"
        }
      ]
    },
    {
      "id": "claim_c4f8be602e4a4c9293bc250d8c539f0c",
      "statement": "Topics opt in with remote.storage.enable, and local.retention.ms/bytes bound local data before deletion, falling back to retention.ms/bytes when unset.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L45-L56",
          "version": "repo-lines-v1:sha256:480f264a88ae84cd3065cd50310c793ba0c45922611edc420b20d780b8210e19:"
        }
      ]
    },
    {
      "id": "claim_b310e67e480a45cebaa20dd395c9aafd",
      "statement": "The quick start uses LocalTieredStorage from the storage test jar with rsm.config.dir and sets rlmm.config.remote.log.metadata.topic.replication.factor and min.isr to 1 for single-broker clusters, and local segments are deleted only after upload.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L58-L139",
          "version": "repo-lines-v1:sha256:64a9fe9e73c55b761b1959dba1033ed1fd7514af6910f83170a820a28be8b729:"
        }
      ]
    },
    {
      "id": "claim_087d9d5ca068495c85613fd121fb52ef",
      "statement": "Setting remote.log.copy.disable=true makes remote logs read-only and requires local retention to equal total retention or -2, while remote.storage.enable=false with remote.log.delete.on.disable=true deletes remote logs; disabling cluster-wide requires deleting tiered topics first.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L141-L168",
          "version": "repo-lines-v1:sha256:67ec1791106d77fe5938898b0d78425a21ef5f10b76497549ba7582027d8fc3c:"
        }
      ]
    },
    {
      "id": "claim_5fe6b6a0e6a2404cbbdbaf99f24318eb",
      "statement": "Tiered storage does not support compacted topics, requires clients 3.0+ for admin actions, and does not support segments lacking producer snapshots from topics created before 2.8.0.",
      "evidence": [
        {
          "resource": "repo://docs/operations/tiered-storage.md#L170-L181",
          "version": "repo-lines-v1:sha256:8b5b20f9acdbf3ddbbc51a3034a66a2648660a99d37abec2fdc361b5a3485700:"
        }
      ]
    },
    {
      "id": "claim_3e2c1b3a807d42669fe36dce837efc51",
      "statement": "TopicBasedRemoteLogMetadataManager configs use the remote.log.metadata.manager.impl.prefix, and its admin, producer and consumer clients can be configured via remote.log.metadata.common.client., admin., producer. and consumer. prefixes.",
      "evidence": [
