# 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git 에 올라가지 않는다).
# 셸에 이미 설정된 환경변수가 있으면 그 값이 우선한다. 비워 둔 항목은 지우면 기본값(로컬 Ollama)을 쓴다.
# base_url 에는 /v1 을 붙이지 않는다.

# 답변 모델
ANSWER_BACKEND=openai
ANSWER_BASE_URL=https://api.openai.com
ANSWER_API_KEY=
ANSWER_MODEL=

# 채점 모델
JUDGE_BACKEND=openai
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=

# 토큰 계산 기준 (답변 모델과 같은 토크나이저)
TOKENIZER=tiktoken:o200k_base

# 임베딩은 설정하지 않으면 로컬 Ollama(bge-m3) 그대로
